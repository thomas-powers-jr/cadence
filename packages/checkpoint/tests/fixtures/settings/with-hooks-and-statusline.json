{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node packages/host-claude-code/bin/cadence-host-claude-code.cjs hook --cadence \"node packages/core/bin/cadence.cjs\""
          }
        ],
        "_managedBy": "cadence"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "deja hook pre-tool-use",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo stopped >> ~/.claude/stop.log"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js --theme \"dark mode\" ünï",
    "padding": 0
  },
  "permissions": {
    "allow": ["Bash(pnpm test:*)", "Read(./**)"],
    "deny": []
  },
  "env": {
    "STATUSLINE_DEBUG": "0"
  }
}
